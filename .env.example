# Server Configuration
PORT=3000
NODE_ENV=development

# Security
ADMIN_CODE=your_admin_code_here
# REQUIRED. Long random string. The insecure "your-secret-key" fallback was
# removed (config/index.js) and the server now refuses to boot without this —
# a predictable JWT secret makes every token (incl. admin) forgeable.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=unused_legacy_no_express_session_in_this_app

# The hidden admin panel needs NO backend env vars — it is a frontend-only
# route (front: REACT_APP_ADMIN_PATH) protected by the existing admin login
# (JWT + User.isAdmin) on every /api/admin-panel/* route.

# Database
MONGODB_URI=mongodb://localhost:27017/your_database_name
# Optional: dedicated cluster for Designer overlays (unset -> main cluster).
# OVERLAY_MONGODB_URI=mongodb+srv://user:pass@overlay-cluster.example.mongodb.net
# OVERLAY_MONGODB_DB=scoresync_overlays
# Optional: storage cap per cluster in MB, used for the admin panel's
# "storage left" figure. Default 512 (Atlas Free M0).
# MONGODB_QUOTA_MB=512
# OVERLAY_MONGODB_QUOTA_MB=512

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# API Keys (if any)
# API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
